{
  "name": "root-network-os",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Local infrastructure simulation with a walkable underground data center",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "assets": "node tools/asset-generator/generate.mjs",
    "assets:audit": "node tools/audit-assets.mjs",
    "assets:inventory": "node tools/inventory-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
