{
  "name": "root-network-os",
  "version": "1.5.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Local infrastructure simulation with a walkable underground data center",
  "main": "desktop/main.cjs",
  "productName": "ROOT · Network OS",
  "author": {
    "name": "Tricade",
    "email": "6281655+Tricade@users.noreply.github.com"
  },
  "homepage": "https://github.com/Tricade/root-network-os",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "desktop": "node tools/desktop/launch.cjs",
    "desktop:smoke": "node tools/desktop/launch.cjs --smoke",
    "desktop:dir": "electron-builder --config electron-builder.config.cjs --dir --publish never",
    "desktop:build": "electron-builder --config electron-builder.config.cjs --publish never",
    "assets": "node tools/asset-generator/generate.mjs",
    "assets:audit": "node tools/audit-assets.mjs",
    "assets:inventory": "node tools/inventory-assets.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "10.0.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.8.5"
  },
  "overrides": {
    "@electron/asar": {
      ".": "4.3.1",
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    },
    "app-builder-lib@26.18.0": {
      "@electron/universal": "3.0.6",
      "ejs": "7.0.2",
      "minimatch": "11.0.3"
    },
    "temp": "file:./tools/desktop/build-temp",
    "eslint@10.14.0": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.3"
    }
  },
  "desktopName": "io.github.tricade.root.desktop"
}
